# AWS credentials for Bedrock. Either mount ~/.aws and set AWS_PROFILE,
# or provide AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN.
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1

# At least one of these must be set to a Bedrock model id or
# application-inference-profile ARN for the model to appear in the UI.
# Dropdown labels are derived from the foundation model each one resolves to.
CLAUDE_SONNET_MODEL_ID=
CLAUDE_OPUS_MODEL_ID=

# Optional: required only if your account enforces a Bedrock guardrail.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
