FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for python-docx/lxml
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libffi-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY CV-creator.py .
COPY userCVprofiling.py .

# user_profile.json is mounted as a volume so both containers share it
# trainingData is not needed by CV-creator

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "CV-creator.py", \
    "--server.port=8501", \
    "--server.address=0.0.0.0", \
    "--server.headless=true", \
    "--server.baseUrlPath=/cv", \
    "--server.enableCORS=false", \
    "--server.enableXsrfProtection=false"]
